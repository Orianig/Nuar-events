---
import StoryPage from '../../../components/pages/StoryPage.astro';
import { stories } from '../../../data/stories';

export function getStaticPaths() {
  return stories.map((story) => ({
    params: { lang: 'en', code: story.code },
  }));
}

const base = import.meta.env.BASE_URL;
const code = Astro.params.code!;
const story = stories.find((s) => s.code === code)!;
---

<StoryPage lang="en" currentPath={Astro.url.pathname} base={base} story={story} />
