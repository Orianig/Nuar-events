---
import Button from '../ui/Button.astro';
import type { ContactSectionProps } from '../../types';

const {
  titleLines = [],
  descriptionLines = [],
  ctaLabel,
  hrefContact,
  backgroundImage = '/general/home/preFooter/hero1.png',
} = Astro.props as ContactSectionProps;
---

<section class="cta-section relative flex min-h-[260px] items-center overflow-hidden md:min-h-[320px] lg:min-h-[360px]">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <img
      src={backgroundImage}
      alt=""
      width="1480"
      height="640"
      class="absolute inset-0 h-full w-full scale-[1.02] object-cover object-[center_40%]"
      loading="lazy"
      decoding="async"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-[var(--color-cta-bleed)]/80 via-[var(--color-cta-bleed)]/50 to-[var(--color-cta-bleed)]/15 md:from-[var(--color-cta-bleed)]/75 md:via-[var(--color-cta-bleed)]/40 md:to-transparent"
    >
    </div>
    <div class="cta-bg-edge cta-bg-edge-left"></div>
    <div class="cta-bg-edge cta-bg-edge-right"></div>
  </div>

  <div class="page-gutter relative z-10 w-full py-10 md:py-12 lg:py-14">
    <div class="page-shell">
      <div class="flex w-full max-w-xl flex-col items-start gap-6 md:max-w-2xl md:gap-8">
        <h2 class="font-body text-[32px] leading-[1.45] tracking-wide text-stone-light">
          {
            titleLines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))
          }
        </h2>

        {
          descriptionLines.length > 0 && (
            <p class="font-body text-base leading-relaxed text-stone-light/85 md:text-lg">
              {descriptionLines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          )
        }

        {
          ctaLabel && hrefContact && (
            <Button
              href={hrefContact}
              variant="ghost"
              size="lg"
              class="w-auto max-[430px]:w-full"
            >
              {ctaLabel}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background-color: var(--color-cta-bleed);
  }

  .cta-bg-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(4rem, 18vw, 14rem);
    pointer-events: none;
  }

  .cta-bg-edge-left {
    left: 0;
    background: linear-gradient(
      to right,
      var(--color-cta-bleed) 0%,
      color-mix(in srgb, var(--color-cta-bleed) 75%, transparent) 45%,
      transparent 100%
    );
  }

  .cta-bg-edge-right {
    right: 0;
    background: linear-gradient(
      to left,
      var(--color-cta-bleed) 0%,
      color-mix(in srgb, var(--color-cta-bleed) 75%, transparent) 45%,
      transparent 100%
    );
  }
</style>
