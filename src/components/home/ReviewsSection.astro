---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import X from '@lucide/astro/icons/x';
import Star from '@lucide/astro/icons/star';
import ReviewCard from '../ui/ReviewCard.astro';
import type { ReviewsSectionProps } from '../../types';

const { kicker, title, items = [] } = Astro.props as ReviewsSectionProps;
const closeLabel = 'Cerrar';
const prevLabel = 'Anterior';
const nextLabel = 'Siguiente';
---

<section class="relative bg-white pb-10 pt-10 text-olive md:pt-12" data-reviews-section>
  <div class="pointer-events-none absolute inset-0 bg-cream-light/30" aria-hidden="true"></div>

  <div class="page-gutter relative">
    <div class="page-shell">
      <div class="relative">
        <p class="font-slogan text-xl leading-none text-olive md:text-2xl">{kicker}</p>
        <h2 class="mt-3 font-body text-2xl font-normal leading-[1.25] text-olive sm:max-w-[calc(100%-6rem)] md:text-[32px]">
          {title}
        </h2>

        {
          items.length > 0 && (
            <div class="absolute bottom-0 right-0 z-10 hidden items-center gap-2 sm:flex">
              <button
                type="button"
                class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-olive-light/70 text-olive transition-colors hover:border-olive hover:bg-sand-light/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive disabled:pointer-events-none disabled:opacity-35"
                data-reviews-prev
                aria-label={prevLabel}
              >
                <ArrowLeft class="size-5" stroke-width={1.8} aria-hidden="true" />
              </button>
              <button
                type="button"
                class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-olive-light/70 text-olive transition-colors hover:border-olive hover:bg-sand-light/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive disabled:pointer-events-none disabled:opacity-35"
                data-reviews-next
                aria-label={nextLabel}
              >
                <ArrowRight class="size-5" stroke-width={1.8} aria-hidden="true" />
              </button>
            </div>
          )
        }
      </div>

      {
        items.length > 0 && (
          <div class="mt-8 overflow-visible" data-reviews-carousel>
            <div class="relative">
              <div
                class="cursor-grab overflow-x-clip overflow-y-visible active:cursor-grabbing touch-pan-y sm:-mx-2 sm:px-2 sm:py-3"
                data-reviews-viewport
              >
                <ul class="flex gap-3 will-change-transform sm:gap-5" data-reviews-track>
                  {items.map((item) => (
                    <li
                      class="w-[88%] min-w-0 shrink-0 sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-2.5rem)/3)]"
                      data-reviews-slide
                    >
                      <ReviewCard
                        quote={item.quote}
                        name={item.name}
                        detail={item.detail}
                        avatar={item.avatar}
                        rating={5}
                        compact
                        interactive
                      />
                    </li>
                  ))}
                </ul>
              </div>

              <div
                class="pointer-events-none absolute inset-y-0 right-0 w-6 bg-gradient-to-l from-[#F5F2EB] to-transparent sm:hidden"
                data-reviews-edge
                aria-hidden="true"
              />
            </div>

            <div
              class="mt-6 flex flex-wrap items-center justify-center gap-2"
              data-reviews-dots
              role="tablist"
              aria-label={title}
            />
          </div>
        )
      }
    </div>
  </div>

  <dialog
    class="review-modal fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none border-0 bg-transparent p-0 open:flex open:items-center open:justify-center"
    data-review-modal
    aria-labelledby="review-modal-title"
  >
    <div class="absolute inset-0 bg-bark/45 backdrop-blur-[2px]" data-review-backdrop aria-hidden="true"></div>
    <div
      class="relative z-10 mx-4 w-full max-w-lg rounded-3xl border border-olive-light/40 bg-[#F2EFEA] p-6 shadow-[0_16px_48px_rgb(41_34_5_/_25%)] sm:p-8"
      role="document"
    >
      <button
        type="button"
        class="absolute right-4 top-4 inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-olive transition-colors hover:bg-stone-light/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive"
        data-review-close
        aria-label={closeLabel}
      >
        <X class="size-4 shrink-0" stroke-width={2} aria-hidden="true" />
      </button>

      <blockquote class="flex gap-3 pr-8">
        <span class="shrink-0 font-body text-6xl leading-none text-olive-light md:text-7xl" aria-hidden="true">
          “
        </span>
        <p class="font-body text-base font-normal leading-relaxed text-olive" data-review-modal-quote></p>
      </blockquote>

      <div class="mt-5 flex items-center gap-1" data-review-modal-stars aria-hidden="true">
        {Array.from({ length: 5 }).map(() => (
          <Star class="size-3.5 shrink-0 fill-olive text-olive" stroke-width={1.6} />
        ))}
      </div>

      <div class="mt-6 flex items-center gap-3">
        <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full bg-white">
          <img
            src=""
            alt=""
            class="hidden h-full w-full object-cover"
            width="48"
            height="48"
            data-review-modal-avatar
          />
          <span class="block h-full w-full bg-white" data-review-modal-avatar-fallback aria-hidden="true"></span>
        </div>
        <div class="min-w-0">
          <p
            id="review-modal-title"
            class="font-body text-sm font-medium leading-snug text-olive"
            data-review-modal-name
          >
          </p>
          <p class="mt-0.5 font-body text-sm font-normal leading-snug text-olive" data-review-modal-detail></p>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  const DRAG_THRESHOLD = 12;
  const PAGE_THRESHOLD = 48;
  const DOTS = 3;

  function openReviewModal(trigger: HTMLElement) {
    const modal = document.querySelector<HTMLDialogElement>('[data-review-modal]');
    if (!modal) return;

    const quoteEl = modal.querySelector<HTMLElement>('[data-review-modal-quote]');
    const nameEl = modal.querySelector<HTMLElement>('[data-review-modal-name]');
    const detailEl = modal.querySelector<HTMLElement>('[data-review-modal-detail]');
    const avatarEl = modal.querySelector<HTMLImageElement>('[data-review-modal-avatar]');
    const avatarFallback = modal.querySelector<HTMLElement>('[data-review-modal-avatar-fallback]');

    const quote = trigger.dataset.reviewQuote || '';
    const name = trigger.dataset.reviewName || '';
    const detail = trigger.dataset.reviewDetail || '';
    const avatar = trigger.dataset.reviewAvatar || '';

    if (quoteEl) quoteEl.textContent = quote;
    if (nameEl) nameEl.textContent = name;
    if (detailEl) {
      detailEl.textContent = detail;
      detailEl.classList.toggle('hidden', !detail);
    }
    if (avatarEl && avatarFallback) {
      if (avatar) {
        avatarEl.src = avatar;
        avatarEl.alt = name;
        avatarEl.classList.remove('hidden');
        avatarFallback.classList.add('hidden');
      } else {
        avatarEl.removeAttribute('src');
        avatarEl.classList.add('hidden');
        avatarFallback.classList.remove('hidden');
      }
    }

    if (typeof modal.showModal === 'function') modal.showModal();
    else modal.setAttribute('open', '');
  }

  function initReviewsCarousels() {
    document.querySelectorAll<HTMLElement>('[data-reviews-carousel]').forEach((root) => {
      if (root.dataset.carouselReady === '1') return;
      root.dataset.carouselReady = '1';

      const section = root.closest<HTMLElement>('[data-reviews-section]') ?? root;
      const viewport = root.querySelector<HTMLElement>('[data-reviews-viewport]');
      const track = root.querySelector<HTMLElement>('[data-reviews-track]');
      const dotsWrap = root.querySelector<HTMLElement>('[data-reviews-dots]');
      const edge = root.querySelector<HTMLElement>('[data-reviews-edge]');
      const prevBtn = section.querySelector<HTMLButtonElement>('[data-reviews-prev]');
      const nextBtn = section.querySelector<HTMLButtonElement>('[data-reviews-next]');
      const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-reviews-slide]'));
      if (!viewport || !track || !dotsWrap || slides.length === 0) return;

      let page = 0;
      let perPage = 1;
      let baseX = 0;
      let dragStartX = 0;
      let dragDelta = 0;
      let dragging = false;
      let didDrag = false;
      let pointerId: number | null = null;
      let blockClick = false;

      const getPerPage = () => {
        if (window.matchMedia('(min-width: 1024px)').matches) return 3;
        if (window.matchMedia('(min-width: 640px)').matches) return 2;
        return 1;
      };

      const pageCount = () => Math.max(1, Math.ceil(slides.length / perPage));

      const pageOffset = (p: number) => {
        const slide = slides[p * perPage];
        return slide ? -slide.offsetLeft : 0;
      };

      const setTransform = (x: number, animate: boolean) => {
        track.style.transition = animate
          ? 'transform 450ms cubic-bezier(0.22, 1, 0.36, 1)'
          : 'none';
        track.style.transform = `translate3d(${x}px, 0, 0)`;
      };

      const updateChrome = () => {
        const total = pageCount();
        const active = page % DOTS;
        dotsWrap.querySelectorAll<HTMLButtonElement>('button').forEach((btn, i) => {
          const on = i === active;
          btn.setAttribute('aria-selected', on ? 'true' : 'false');
          btn.classList.toggle('bg-olive', on);
          btn.classList.toggle('bg-sand-light', !on);
        });
        if (prevBtn) prevBtn.disabled = total <= 1;
        if (nextBtn) nextBtn.disabled = total <= 1;
        edge?.classList.toggle('opacity-0', page >= total - 1);
      };

      const goTo = (next: number, animate = true) => {
        const total = pageCount();
        page = ((next % total) + total) % total;
        baseX = pageOffset(page);
        setTransform(baseX, animate);
        updateChrome();
      };

      const goToDot = (slot: number) => {
        const current = page % DOTS;
        if (slot === current) {
          goTo(page + 1);
          return;
        }
        const steps = (slot - current + DOTS) % DOTS;
        goTo(page + steps);
      };

      const renderDots = () => {
        dotsWrap.innerHTML = '';
        for (let i = 0; i < DOTS; i++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('role', 'tab');
          btn.setAttribute('aria-label', `${i + 1} / ${DOTS}`);
          btn.className =
            'h-2.5 w-2.5 cursor-pointer rounded-full bg-sand-light transition-colors duration-200 hover:bg-olive/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive';
          btn.addEventListener('click', () => goToDot(i));
          dotsWrap.appendChild(btn);
        }
      };

      const refresh = () => {
        perPage = getPerPage();
        if (page >= pageCount()) page = 0;
        renderDots();
        goTo(page, false);
      };

      const endDrag = () => {
        if (!dragging) return;
        const wasDrag = didDrag;
        dragging = false;
        pointerId = null;

        if (wasDrag) {
          blockClick = true;
          window.setTimeout(() => {
            blockClick = false;
          }, 0);
          if (dragDelta <= -PAGE_THRESHOLD) goTo(page + 1);
          else if (dragDelta >= PAGE_THRESHOLD) goTo(page - 1);
          else goTo(page);
        } else {
          setTransform(baseX, true);
        }

        dragDelta = 0;
        didDrag = false;
      };

      viewport.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true;
        didDrag = false;
        pointerId = e.pointerId;
        dragStartX = e.clientX;
        dragDelta = 0;
        baseX = pageOffset(page);
      });

      viewport.addEventListener('pointermove', (e) => {
        if (!dragging || pointerId !== e.pointerId) return;
        dragDelta = e.clientX - dragStartX;
        if (Math.abs(dragDelta) < DRAG_THRESHOLD) return;
        if (!didDrag) {
          didDrag = true;
          try {
            viewport.setPointerCapture(e.pointerId);
          } catch {
            /* ignore */
          }
        }
        setTransform(baseX + dragDelta, false);
      });

      viewport.addEventListener('pointerup', (e) => {
        if (pointerId !== e.pointerId) return;
        endDrag();
      });
      viewport.addEventListener('pointercancel', (e) => {
        if (pointerId !== e.pointerId) return;
        endDrag();
      });

      root.addEventListener('click', (e) => {
        const trigger = (e.target as HTMLElement | null)?.closest?.(
          '[data-review-trigger]',
        ) as HTMLElement | null;
        if (!trigger || !root.contains(trigger)) return;
        if (blockClick || didDrag) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        openReviewModal(trigger);
      });

      prevBtn?.addEventListener('click', () => goTo(page - 1));
      nextBtn?.addEventListener('click', () => goTo(page + 1));

      window.addEventListener('resize', refresh);
      refresh();
    });
  }

  function initReviewModal() {
    const section = document.querySelector<HTMLElement>('[data-reviews-section]');
    const modal = document.querySelector<HTMLDialogElement>('[data-review-modal]');
    if (!section || !modal || modal.dataset.ready === '1') return;
    modal.dataset.ready = '1';

    const closeBtn = modal.querySelector<HTMLElement>('[data-review-close]');
    const backdrop = modal.querySelector<HTMLElement>('[data-review-backdrop]');

    const close = () => {
      if (typeof modal.close === 'function') modal.close();
      else modal.removeAttribute('open');
    };

    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    modal.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
  }

  function initReviewsUI() {
    initReviewsCarousels();
    initReviewModal();
  }

  initReviewsUI();
  document.addEventListener('astro:page-load', initReviewsUI);
</script>

<style>
  .review-modal::backdrop {
    background: transparent;
  }
</style>
