---
import Button from '../ui/Button.astro';
import type { ExperiencesSectionProps } from '../../types';

const {
  kicker,
  titleLine1,
  titleLine2,
  paragraphs = [],
  ctaLabel,
  hrefAbout,
  items = [],
} = Astro.props as ExperiencesSectionProps;
---

<section class="bg-btn-secondary py-10">
  <div class="page-gutter">
    <div class="page-shell">
      <!--
        Responsive (contenido dentro de 1440):
        - ≥1366: texto izq + 4 cards a la derecha (siguiente tamaño típico tras 1440)
        - ≥1440: más aire (gaps y texto un poco más anchos)
        - md–1365: texto arriba (ancho completo) + 4 cards en fila
        - 400–767: texto arriba + grid 2×2
        - <400: 1 card por fila
      -->
      <div class="flex flex-col gap-3 min-[1366px]:gap-3.5">
        <p class="font-slogan text-xl leading-none text-bark md:text-2xl">{kicker}</p>

        <div
          class="flex flex-col gap-8 md:gap-10 min-[1366px]:flex-row min-[1366px]:items-start min-[1366px]:justify-between min-[1366px]:gap-8 min-[1440px]:gap-10"
        >
          <div
            class="flex w-full flex-col items-start gap-3 min-[1366px]:max-w-[420px] min-[1366px]:shrink-0 min-[1366px]:gap-3.5 min-[1440px]:max-w-[480px]"
          >
            <h2 class="font-title text-[1.75rem] leading-[1.2] text-bark md:text-[2rem] min-[1366px]:text-[2.05rem] min-[1440px]:text-[2.15rem]">
              {titleLine1}
              <br />
              {titleLine2}
            </h2>
            <div class="flex max-w-3xl flex-col gap-3 font-body text-sm leading-relaxed text-bark/90 min-[1366px]:max-w-none">
              {paragraphs.map((p) => <p>{p}</p>)}
            </div>
            <Button href={hrefAbout} variant="text" size="md" class="!mt-1 !px-0 !text-bark">
              {ctaLabel}
            </Button>
          </div>

          <div
            class="grid w-full grid-cols-2 gap-x-4 gap-y-6 max-[399px]:grid-cols-1 md:grid-cols-4 md:gap-x-6 min-[1366px]:flex min-[1366px]:w-auto min-[1366px]:shrink-0 min-[1366px]:gap-8 min-[1440px]:gap-10"
          >
            {
              items.map((item) => (
                <a
                  href={item.href}
                  class="group/exp flex w-full flex-col gap-2 text-left no-underline outline-none transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive min-[1366px]:w-[180px]"
                >
                  <div class="aspect-[9/10] w-full overflow-hidden rounded-[10px] bg-white min-[1366px]:aspect-auto min-[1366px]:h-[200px] min-[1366px]:w-[180px]">
                    <img
                      src={item.image}
                      alt=""
                      width="180"
                      height="200"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover/exp:scale-[1.03] motion-reduce:transition-none"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="flex flex-col gap-2.5">
                    <h3 class="font-body text-base font-bold leading-snug text-bark">{item.title}</h3>
                    <p class="font-body text-xs leading-relaxed text-bark/80">{item.description}</p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
