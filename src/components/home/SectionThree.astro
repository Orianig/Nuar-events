---
import type { SectionThreeProps } from '../../types';

const { backgroundColor } = Astro.props as SectionThreeProps;

const desktopFrame = {
  width: '107.2738%',
  height: '114.6228%',
  left: '-3.3448%',
  top: '-7.6499%',
};

const mobileFrame = {
  width: '111.8012%',
  height: '109.7143%',
  left: '-6.3147%',
  top: '-5.2571%',
};
---

<section class={`relative overflow-hidden ${backgroundColor ?? ''}`}>
  <h2 class="sr-only">Valores</h2>

  <div class="relative hidden md:block">
    <div class="relative h-[480px] w-full lg:h-[540px] xl:h-[580px]">
      <img
        src="/general/home/sectionBg/SectionThree-BgGr-Desktop.svg"
        alt=""
        aria-hidden="true"
        width="1920"
        height="1080"
        loading="lazy"
        decoding="async"
        class="pointer-events-none absolute inset-0 h-full w-full scale-105 object-cover object-center"
      />

      <div class="relative z-10 mx-auto box-border flex h-full w-full max-w-[1500px] px-6 py-8 lg:px-10 lg:py-10 xl:px-12 xl:py-12">
        <div class="relative min-h-0 w-full flex-1 overflow-hidden">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute bg-no-repeat"
            style={`background-image: url('/general/home/sectionBg/SectionThree-Bg-Desktop.svg'); background-size: 100% 100%; width: ${desktopFrame.width}; height: ${desktopFrame.height}; left: ${desktopFrame.left}; top: ${desktopFrame.top};`}
          ></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <img
              src="/general/home/sectionBg/SectionThree-Center-Desktop.svg"
              alt=""
              aria-hidden="true"
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
              class="absolute left-1/2 top-[48%] h-[90%] w-[90%] -translate-x-1/2 -translate-y-1/2 object-contain object-center"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="relative md:hidden">
    <div class="relative h-[620px] w-full sm:h-[700px]">
      <img
        src="/general/home/sectionBg/SectionThree-BgGr-mobile.png"
        alt=""
        aria-hidden="true"
        width="900"
        height="1200"
        loading="lazy"
        decoding="async"
        class="pointer-events-none absolute inset-0 z-0 h-full w-full scale-105 object-cover object-center"
      />

      <div class="relative z-10 mx-auto box-border flex h-full w-full max-w-[1500px] px-5 py-8 sm:px-6 sm:py-10">
        <div class="relative min-h-0 w-full flex-1 overflow-hidden">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute z-0 bg-no-repeat"
            style={`background-image: url('/general/home/sectionBg/SectionThree-Bg-mobile.png'); background-size: 100% 100%; width: ${mobileFrame.width}; height: ${mobileFrame.height}; left: ${mobileFrame.left}; top: ${mobileFrame.top};`}
          ></div>
          <div class="absolute inset-0 z-10 flex items-center justify-center">
            <img
              src="/general/home/sectionBg/SectionThree-Center-Mobile.png"
              alt=""
              aria-hidden="true"
              width="900"
              height="1200"
              loading="lazy"
              decoding="async"
              class="absolute left-1/2 top-[48%] h-[118%] w-[118%] -translate-x-1/2 -translate-y-1/2 object-contain object-center"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
