---
import type { IntroAnimationProps } from '../../types';

const {
  logoSrc = '/logos/greenClearLogo.png',
  backgroundColor = '#d1cda7',
} = Astro.props as IntroAnimationProps;

const base = import.meta.env.BASE_URL;
const assetBase = base.endsWith('/') ? base : `${base}/`;
const logoPath = logoSrc.startsWith('http')
  ? logoSrc
  : `${assetBase}${logoSrc.replace(/^\/+/, '')}`;
---

<script is:inline>
  try {
    if (sessionStorage.getItem('nuar-intro-played') === '1') {
      document.documentElement.classList.add('nuar-intro-skip');
    }
  } catch (e) {}
</script>

<div
  id="intro-animation"
  class="nuar-intro fixed inset-0 z-50 hidden h-screen w-screen pointer-events-none"
  aria-hidden="true"
>
  <div class="absolute inset-0 flex h-full w-full items-center justify-center bg-transparent">
    <div class="intro-anim-logo relative z-60 w-[35%] max-w-[250px] max-md:w-[40%]">
      <img src={logoPath} alt="" class="block h-auto w-full" width="250" height="80" />
    </div>
    <div
      class="intro-anim-reveal absolute bottom-0 left-1/2 z-55 h-0 w-[200px] -translate-x-1/2 bg-transparent max-md:w-[160px]"
      style={`--mask-color: ${backgroundColor};`}
    >
    </div>
  </div>
</div>

<script>
  const SESSION_KEY = 'nuar-intro-played';
  const introElement = document.getElementById('intro-animation');
  if (
    introElement &&
    (document.documentElement.classList.contains('nuar-intro-skip') ||
      sessionStorage.getItem(SESSION_KEY) === '1')
  ) {
    document.documentElement.classList.add('nuar-intro-skip');
    introElement.remove();
  } else if (introElement) {
    try {
      sessionStorage.setItem(SESSION_KEY, '1');
    } catch (e) {}

    introElement.classList.remove('hidden');
    introElement.classList.add('is-playing');
    document.body.style.overflow = 'hidden';

    window.setTimeout(() => {
      document.body.style.overflow = '';
      window.setTimeout(() => {
        document.documentElement.classList.add('nuar-intro-skip');
        introElement.classList.add('hidden');
        introElement.classList.remove('is-playing');
        introElement.remove();
      }, 300);
    }, 4700);
  }
</script>
