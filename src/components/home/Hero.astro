---
import type { HeroProps } from '../../types';
import Button from '../ui/Button.astro';

const {
  titleLines = [],
  subtitle = '',
  ctaPrimary = 'Organiza tu evento',
  ctaSecondary = 'Descubre NUAR',
  hrefPrimary = '/contact',
  hrefSecondary = '/about-nuar',
  backgroundImage = '/general/home/hero/hero1.png',
  height = 'h-auto lg:h-[min(62svh,640px)] lg:min-h-[520px]',
} = Astro.props as HeroProps;
---

<section class={`relative flex ${height} items-center overflow-hidden bg-hero-bleed`}>
  <div class="pointer-events-none absolute inset-0 flex justify-center" aria-hidden="true">
    <div class="hero-bg-frame relative h-full w-full max-w-370">
      <img
        src={backgroundImage}
        alt=""
        width="1480"
        height="640"
        class="h-full w-full object-cover object-[center_40%] opacity-45 md:opacity-100 md:object-center"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="hero-bg-edge hero-bg-edge-left"></div>
      <div class="hero-bg-edge hero-bg-edge-right"></div>
    </div>
  </div>

  <div class="page-gutter relative z-10 w-full pt-36 pb-12 md:pt-34 md:pb-14 lg:pt-30 lg:pb-8">
    <div class="page-shell-nav">
      <div class="flex w-full max-w-xl flex-col items-start gap-5 md:max-w-2xl md:gap-6">
        <h1 class="font-body text-[1.65rem] leading-[1.28] tracking-wide text-stone-light uppercase sm:text-3xl md:text-[2.35rem] md:leading-[1.28] lg:text-[3.1rem]">
          {
            titleLines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))
          }
        </h1>

        <p class="max-w-md font-body text-sm leading-relaxed text-stone-light/90 md:max-w-lg md:text-base">
          {subtitle}
        </p>

        <div class="flex w-full flex-col gap-3 md:flex-row md:flex-wrap md:items-center md:gap-4">
          <Button href={hrefPrimary} variant="primary" size="lg" class="w-full md:w-auto">
            {ctaPrimary}
          </Button>
          <Button href={hrefSecondary} variant="ghost" size="lg" class="w-full md:w-auto">
            {ctaSecondary}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
