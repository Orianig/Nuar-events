---
import Calendar from '@lucide/astro/icons/calendar';
import Users from '@lucide/astro/icons/users';
import MapPin from '@lucide/astro/icons/map-pin';
import Button from '../ui/Button.astro';
import type { MomentsSectionProps } from '../../types';

const { kicker, title, ctaLabel, hrefEvents, items = [] } = Astro.props as MomentsSectionProps;
---

<section class="relative bg-white pb-8 text-olive md:pb-10">
  <div class="pointer-events-none absolute inset-0 bg-sand-light/30" aria-hidden="true"></div>

  <div class="page-gutter relative">
    <div class="page-shell">
      <div class="h-px w-full bg-sand-light" aria-hidden="true"></div>
      <p class="mt-8 font-slogan text-xl leading-none text-olive md:text-2xl">{kicker}</p>
      <h2 class="mt-3 font-body text-2xl font-normal leading-tight text-olive md:text-[32px]">
        {title}
      </h2>

      <div class="mt-8 flex flex-col sm:mt-10 xl:flex-row xl:items-center xl:gap-6">
        <div class="grid w-full min-w-0 grid-cols-2 gap-x-4 gap-y-5 max-[399px]:grid-cols-1 sm:gap-x-5 sm:gap-y-6 lg:grid-cols-4 lg:gap-5 xl:gap-6">
          {
            items.map((item) => {
              const href = item.href ?? hrefEvents;

              return (
                <a
                  href={href}
                  class="group/moment relative flex aspect-square w-full flex-col overflow-hidden rounded-[14px] bg-white shadow-[0_1px_4px_rgb(91_88_53/8%)] no-underline outline-none transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:shadow-[0_6px_18px_rgb(91_88_53/14%)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive"
                >
                  <div class="min-h-0 flex-1 overflow-hidden bg-cream-light/60">
                    {item.image ? (
                      <img
                        src={item.image}
                        alt=""
                        width="280"
                        height="280"
                        class="h-full w-full object-cover transition-transform duration-300 group-hover/moment:scale-[1.04] motion-reduce:transition-none"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : null}
                  </div>
                  <div class="flex shrink-0 flex-col gap-1.5 px-3.5 py-3 text-olive">
                    <div class="flex items-center gap-2">
                      <Calendar class="size-3.5 shrink-0" stroke-width={1.6} aria-hidden="true" />
                      <span class="font-body truncate text-sm leading-none">{item.event}</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <Users class="size-3.5 shrink-0" stroke-width={1.6} aria-hidden="true" />
                      <span class="font-body truncate text-sm leading-none">{item.attendees}</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <MapPin class="size-3.5 shrink-0" stroke-width={1.6} aria-hidden="true" />
                      <span class="font-body truncate text-sm leading-none">{item.location}</span>
                    </div>
                  </div>
                </a>
              );
            })
          }
        </div>

        {
          ctaLabel && hrefEvents && (
            <div class="shrink-0 pt-6 xl:pl-1 xl:pt-0">
              <Button
                href={hrefEvents}
                variant="text"
                size="md"
                class="!min-h-0 !px-0 !py-0 !text-olive whitespace-nowrap"
              >
                {ctaLabel}
              </Button>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
