---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../layout/Navbar.astro';
import Footer from '../layout/Footer.astro';
import Chip from '../ui/Chip.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import { getTranslations } from '../../i18n';
import { EVENT_TYPE_SLUGS, type EventTypeSlug } from '../../lib/eventTypes';
import { stories, localize, storyHref } from '../../data/stories';
import type { PageProps } from '../../types';

const { lang, currentPath, base } = Astro.props as PageProps;
const t = getTranslations(lang);
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const hrefContact = lang === 'es' ? (b ? `${b}/contact` : '/contact') : (b ? `${b}/en/contact` : '/en/contact');

const typeLabels: Record<EventTypeSlug, string> = {
  corporativos: t.nav.eventTypes.corporate,
  bodas: t.nav.eventTypes.weddings,
  cumpleanos: t.nav.eventTypes.birthdays,
  graduaciones: t.nav.eventTypes.graduations,
  otros: t.nav.eventTypes.others,
};

const filters = [
  { value: 'todos', label: t.eventsAll.filterAll },
  ...EVENT_TYPE_SLUGS.map((slug) => ({ value: slug, label: typeLabels[slug] })),
];

const cards = stories.map((story) => {
  const name = localize(story.name, lang);
  const location = localize(story.location, lang);
  const experience = localize(story.experience, lang);
  const attendees =
    lang === 'en' ? `${story.attendeesLabel} guests` : `${story.attendeesLabel} asistentes`;

  return {
    code: story.code,
    type: story.type,
    title: name,
    subtitle: `${location} · ${attendees}`,
    description: experience,
    image: story.coverImage,
    href: storyHref(story.code, lang, base),
  };
});

const pageTitle = `${t.eventsAll.title} - Nuar`;
---

<Layout
  title={pageTitle}
  description={t.eventsAll.description}
  lang={lang}
  currentPath={currentPath}
>
  <Navbar
    currentPath={currentPath}
    brandName={t.nav.brandName}
    home={t.nav.home}
    projects={t.nav.projects}
    aboutNuar={t.nav.aboutNuar}
    upcomingEvents={t.nav.upcomingEvents}
    contact={t.nav.contact}
    menuToggle={t.nav.menuToggle}
    currentLang={lang}
    base={base}
  />

  <main class="relative flex min-h-dvh flex-col bg-white pt-28 text-olive" data-events-all data-empty="0">
    <div class="pointer-events-none absolute inset-0 bg-cream-light/30" aria-hidden="true"></div>
    <div class="page-gutter relative flex-1" data-events-main>
      <div class="page-shell relative pb-6 sm:pb-8">
        <header class="max-w-2xl">
          <p class="font-slogan text-xl leading-none text-olive md:text-2xl">{t.eventsAll.kicker}</p>
          <h1 class="mt-3 font-body text-2xl font-normal leading-[1.25] text-olive md:text-[32px]">
            {t.eventsAll.title}
          </h1>
          <p class="mt-4 font-body text-base leading-relaxed text-olive/85">
            {t.eventsAll.description}
          </p>
        </header>

        <div
          class="mt-8 flex flex-wrap gap-2 pb-5 sm:mt-10 sm:gap-3"
          data-events-filters
          role="group"
          aria-label={t.eventsAll.title}
        >
          {
            filters.map((filter, i) => (
              <Chip value={filter.value} active={i === 0}>
                {filter.label}
              </Chip>
            ))
          }
        </div>

        <div class="h-px w-full bg-olive/20" aria-hidden="true"></div>

        <div
          class="grid grid-cols-1 gap-x-5 gap-y-5 pt-5 min-[480px]:grid-cols-2 min-[900px]:grid-cols-[repeat(auto-fill,minmax(240px,1fr))] sm:gap-y-6"
          data-events-grid
        >
          {
            cards.map((card) => (
              <div class="min-w-0 w-full" data-event-type={card.type} data-event-card>
                <Card
                  title={card.title}
                  subtitle={card.subtitle}
                  description={card.description}
                  image={card.image}
                  imageAlt={card.title}
                  href={card.href}
                  ctaLabel={t.eventsAll.cardCta}
                  eventType={card.type}
                  compact
                />
              </div>
            ))
          }
        </div>

        <p
          class="hidden pt-5 text-center font-body text-base leading-relaxed text-olive/75 md:text-lg"
          data-events-empty
          role="status"
        >
          {t.eventsAll.emptyFilter}
        </p>
      </div>
    </div>

    <section
      class="events-all-cta relative z-[1] -mb-px flex w-full min-h-[240px] items-center overflow-hidden bg-[#24281a] md:min-h-[280px] lg:min-h-[320px]"
      aria-labelledby="events-all-cta-title"
    >
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <img
          src="/general/home/preFooter/hero1.png"
          alt=""
          width="1480"
          height="640"
          class="absolute inset-0 h-full w-full scale-[1.02] object-cover object-[center_55%] opacity-80 md:opacity-100 md:object-center"
          loading="lazy"
          decoding="async"
        />
        <div class="events-all-cta-edge events-all-cta-edge-left"></div>
        <div class="events-all-cta-edge events-all-cta-edge-right"></div>
      </div>

      <div class="page-gutter relative z-10 w-full py-7 md:py-8 lg:py-9">
        <div class="page-shell">
          <div class="flex w-full max-w-xl flex-col items-start gap-6 md:max-w-2xl md:gap-8">
            <h2
              id="events-all-cta-title"
              class="font-body text-[32px] leading-[1.45] tracking-wide text-stone-light"
            >
              {t.eventsAll.ctaTitle}
            </h2>
            <p class="font-body text-base leading-relaxed text-stone-light/85 md:text-lg">
              {
                t.eventsAll.ctaDescriptionLines.map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))
              }
            </p>
            <Button
              href={hrefContact}
              variant="ghost"
              size="lg"
              class="w-auto max-[430px]:w-full"
            >
              {t.eventsAll.ctaLabel}
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    [data-events-all][data-empty='1'] [data-events-main] {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
    }

    [data-events-all][data-empty='1'] [data-events-main] > .page-shell {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
    }

    [data-events-all][data-empty='1'] [data-events-empty] {
      flex: 1 1 auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    [data-events-all][data-empty='1'] .events-all-cta {
      margin-top: auto;
    }

    .events-all-cta {
      box-shadow: 0 2px 0 0 #24281a;
    }

    .events-all-cta-edge {
      position: absolute;
      top: 0;
      bottom: 0;
      width: clamp(4rem, 18vw, 14rem);
      pointer-events: none;
    }

    .events-all-cta-edge-left {
      left: 0;
      background: linear-gradient(
        to right,
        #24281a 0%,
        color-mix(in srgb, #24281a 75%, transparent) 45%,
        transparent 100%
      );
    }

    .events-all-cta-edge-right {
      right: 0;
      background: linear-gradient(
        to left,
        #24281a 0%,
        color-mix(in srgb, #24281a 75%, transparent) 45%,
        transparent 100%
      );
    }
  </style>

  <Footer
    brandName={t.nav.brandName}
    sloganLine1={t.footer.sloganLine1}
    sloganLine2={t.footer.sloganLine2}
    followUs={t.footer.followUs}
    privacy={t.footer.privacy}
    currentLang={lang}
    base={base}
  />
</Layout>

<script>
  function initEventsFilters() {
    const root = document.querySelector<HTMLElement>('[data-events-all]');
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const filters = root.querySelector<HTMLElement>('[data-events-filters]');
    const grid = root.querySelector<HTMLElement>('[data-events-grid]');
    const empty = root.querySelector<HTMLElement>('[data-events-empty]');
    if (!filters || !grid || !empty) return;

    const chips = Array.from(filters.querySelectorAll<HTMLButtonElement>('button[data-value]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-event-card]'));

    const setActive = (value: string) => {
      chips.forEach((chip) => {
        const on = chip.dataset.value === value;
        chip.setAttribute('aria-pressed', on ? 'true' : 'false');
        chip.classList.toggle('border-olive-light', on);
        chip.classList.toggle('bg-stone-light', on);
        chip.classList.toggle('text-olive-light', on);
        chip.classList.toggle('border-transparent', !on);
        chip.classList.toggle('bg-stone-light/50', !on);
      });

      let visible = 0;
      cards.forEach((card) => {
        const type = card.dataset.eventType || '';
        const show = value === 'todos' || type === value;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      const isEmpty = visible === 0;
      root.dataset.empty = isEmpty ? '1' : '0';
      grid.classList.toggle('hidden', isEmpty);
      empty.classList.toggle('hidden', !isEmpty);
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const value = chip.dataset.value || 'todos';
        setActive(value);
      });
    });
  }

  initEventsFilters();
  document.addEventListener('astro:page-load', initEventsFilters);
</script>
