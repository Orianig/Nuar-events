---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../layout/Navbar.astro';
import Footer from '../layout/Footer.astro';
import Hero from '../home/Hero.astro';
import ExperiencesSection from '../home/ExperiencesSection.astro';
import SectionTwo from '../home/SectionTwo.astro';
import SectionThree from '../home/SectionThree.astro';
import IntroAnimation from '../home/IntroAnimation.astro';
import { getTranslations } from '../../i18n';
import { EVENT_TYPE_IMAGES, eventTypeHref } from '../../lib/eventTypes';
import type { PageProps } from '../../types';

const { lang, currentPath, base } = Astro.props as PageProps;
const t = getTranslations(lang);
const assetBase = base.endsWith('/') ? base : `${base}/`;
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const isSpanish = lang === 'es';
const hrefContact = isSpanish ? (b ? `${b}/contact` : '/contact') : (b ? `${b}/en/contact` : '/en/contact');
const hrefAboutNuar = isSpanish
  ? b
    ? `${b}/about-nuar`
    : '/about-nuar'
  : b
    ? `${b}/en/about-nuar`
    : '/en/about-nuar';

const experienceItems = [
  {
    title: t.experiences.cards.corporate.title,
    description: t.experiences.cards.corporate.description,
    image: EVENT_TYPE_IMAGES.corporativos,
    href: eventTypeHref('corporativos', lang, base),
  },
  {
    title: t.experiences.cards.celebrations.title,
    description: t.experiences.cards.celebrations.description,
    image: EVENT_TYPE_IMAGES.celebraciones,
    href: eventTypeHref('celebraciones', lang, base),
  },
  {
    title: t.experiences.cards.weddings.title,
    description: t.experiences.cards.weddings.description,
    image: EVENT_TYPE_IMAGES.bodas,
    href: eventTypeHref('bodas', lang, base),
  },
  {
    title: t.experiences.cards.experiences.title,
    description: t.experiences.cards.experiences.description,
    image: EVENT_TYPE_IMAGES['experiencias-nuar'],
    href: eventTypeHref('experiencias-nuar', lang, base),
  },
];
---

<Layout title={t.pages.home.title} description={t.hero.slogan} lang={lang} currentPath={currentPath}>
  <IntroAnimation />

  <Navbar
    brandName={t.nav.brandName}
    home={t.nav.home}
    projects={t.nav.projects}
    aboutNuar={t.nav.aboutNuar}
    upcomingEvents={t.nav.upcomingEvents}
    contact={t.nav.contact}
    menuToggle={t.nav.menuToggle}
    currentLang={lang}
    currentPath={currentPath}
    base={base}
  />

  <Hero
    titleLines={[...t.hero.titleLines]}
    subtitle={t.hero.subtitle}
    ctaPrimary={t.hero.ctaPrimary}
    ctaSecondary={t.hero.ctaSecondary}
    hrefPrimary={hrefContact}
    hrefSecondary={hrefAboutNuar}
    backgroundImage={`${assetBase}home-bg-header.jpg`}
  />

  <ExperiencesSection
    kicker={t.experiences.kicker}
    titleLine1={t.experiences.titleLine1}
    titleLine2={t.experiences.titleLine2}
    paragraphs={[...t.experiences.paragraphs]}
    ctaLabel={t.experiences.ctaLabel}
    hrefAbout={hrefAboutNuar}
    items={experienceItems}
  />

  <SectionTwo sectionTitle={t.sectionTwo.sectionTitle || undefined} items={[...t.sectionTwo.items]} />

  <SectionThree
    image={t.sectionThree.image}
    centerText={t.sectionThree.centerText}
    quote={t.sectionThree.quote}
    imageAlt={t.sectionThree.imageAlt}
    effectType="reveal"
  />

  <Footer brandName={t.nav.brandName} sloganLine1={t.footer.sloganLine1} sloganLine2={t.footer.sloganLine2} followUs={t.footer.followUs} privacy={t.footer.privacy} currentLang={lang} base={base} />
</Layout>
