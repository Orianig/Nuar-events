---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props as Props;
---

<header class="max-w-3xl">
  <h2 class="font-body text-[32px] font-normal leading-[1.25] text-olive">
    {title}
  </h2>
  {
    description && (
      <p class="mt-4 max-w-2xl font-body text-base leading-relaxed text-olive/85">
        {description}
      </p>
    )
  }
</header>
