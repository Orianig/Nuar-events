---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../layout/Navbar.astro';
import Footer from '../layout/Footer.astro';
import TypologyHero from './TypologyHero.astro';
import TypologyIntro from './TypologyIntro.astro';
import TypologyItems from './TypologyItems.astro';
import TypologyFeatured from './TypologyFeatured.astro';
import ContactSection from '../home/ContactSection.astro';
import { getTranslations } from '../../i18n';
import { EVENT_TYPE_SLUGS, allEventsHref, type EventTypeSlug } from '../../lib/eventTypes';
import { getTypology, typologyTitleLines } from '../../data/typologies';
import { attendeesText, getStoriesByType, localize, storyHref } from '../../data/stories';
import type { PageProps } from '../../types';

interface Props extends PageProps {
  eventType: EventTypeSlug;
}

const { lang, currentPath, base, eventType } = Astro.props as Props;
const t = getTranslations(lang);
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const hrefContact = lang === 'es' ? (b ? `${b}/contact` : '/contact') : (b ? `${b}/en/contact` : '/en/contact');
const hrefAllEvents = allEventsHref(lang, base);

const typology = getTypology(eventType);

const labels = {
  corporativos: t.nav.eventTypes.corporate,
  bodas: t.nav.eventTypes.weddings,
  cumpleanos: t.nav.eventTypes.birthdays,
  graduaciones: t.nav.eventTypes.graduations,
  otros: t.nav.eventTypes.others,
} as const;

const pageTitle = typology
  ? `${localize(typology.typology, lang)} - Nuar`
  : `${labels[eventType]} - Nuar`;
const pageDescription = typology
  ? localize(typology.descriptionHero, lang)
  : lang === 'en'
    ? `Nuar Events — ${labels[eventType]}.`
    : `Nuar Events — ${labels[eventType]}.`;

const eventTypes = EVENT_TYPE_SLUGS.map((slug) => ({
  label: labels[slug],
  href:
    lang === 'en'
      ? b
        ? `${b}/en/eventos/${slug}`
        : `/en/eventos/${slug}`
      : b
        ? `${b}/eventos/${slug}`
        : `/eventos/${slug}`,
}));

const titleLines = typology ? typologyTitleLines(typology.titleHero, lang) : [labels[eventType]];
const dossierHref = typology?.dossier || undefined;

const bodyTitle = typology ? localize(typology.title, lang).trim() : '';
const bodyDescription = typology ? localize(typology.description, lang).trim() : '';
const bodyItems =
  typology?.items.map((item) => ({
    icon: item.logo,
    title: localize(item.title, lang),
    description: localize(item.description, lang),
  })) ?? [];

const featuredStories = getStoriesByType(eventType, 4);
const featuredItems = featuredStories.map((story) => ({
  event: localize(story.name, lang),
  attendees: attendeesText(story, lang),
  location: localize(story.location, lang),
  image: story.coverImage,
  href: storyHref(story.code, lang, base),
}));
---

<Layout title={pageTitle} description={pageDescription} lang={lang} currentPath={currentPath}>
  <Navbar
    currentPath={currentPath}
    brandName={t.nav.brandName}
    home={t.nav.home}
    projects={t.nav.projects}
    aboutNuar={t.nav.aboutNuar}
    upcomingEvents={t.nav.upcomingEvents}
    contact={t.nav.contact}
    menuToggle={t.nav.menuToggle}
    eventTypes={eventTypes}
    currentLang={lang}
    base={base}
  />

  {
    typology ? (
      <>
        <TypologyHero
          littleTitle={localize(typology.littleTitleHero, lang)}
          titleLines={titleLines}
          description={localize(typology.descriptionHero, lang)}
          ctaPrimary={t.typologyPage.ctaPrimary}
          ctaSecondary={t.typologyPage.ctaSecondary}
          hrefPrimary={hrefContact}
          hrefSecondary={dossierHref}
          backgroundImage={typology.coverImage}
          bleedColor={typology.bleedColor}
        />

        <main class="relative bg-white text-olive">
          <div class="pointer-events-none absolute inset-0 bg-cream-light/30" aria-hidden="true"></div>
          <div class="page-gutter relative">
            <div class="page-shell flex flex-col gap-10 py-10">
              {bodyTitle && <TypologyIntro title={bodyTitle} description={bodyDescription} />}
              {bodyItems.length > 0 && <TypologyItems items={bodyItems} />}
              {featuredItems.length > 0 && (
                <TypologyFeatured
                  kicker={t.typologyPage.featuredKicker}
                  title={t.typologyPage.featuredTitle}
                  ctaLabel={t.typologyPage.featuredCta}
                  hrefEvents={hrefAllEvents}
                  items={featuredItems}
                />
              )}
            </div>
          </div>
        </main>

        <ContactSection
          titleLines={[t.typologyPage.bottomCtaTitle]}
          descriptionLines={[...t.typologyPage.bottomCtaDescriptionLines]}
          ctaLabel={t.typologyPage.bottomCtaLabel}
          hrefContact={hrefContact}
          backgroundImage="/general/home/preFooter/hero1.png"
        />
      </>
    ) : (
      <main class="flex min-h-[70vh] flex-col items-center justify-center bg-stone px-8 pb-16 pt-28 text-center">
        <h1 class="font-body text-4xl text-bark md:text-5xl">{labels[eventType]}</h1>
      </main>
    )
  }

  <Footer
    brandName={t.nav.brandName}
    sloganLine1={t.footer.sloganLine1}
    sloganLine2={t.footer.sloganLine2}
    followUs={t.footer.followUs}
    privacy={t.footer.privacy}
    currentLang={lang}
    base={base}
  />
</Layout>
