---
interface Item {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  items: Item[];
}

const { items = [] } = Astro.props as Props;
---

{
  items.length > 0 && (
    <div class="flex flex-col">
      {/* Exterior corta → interior completa */}
      <div class="mx-auto h-px w-[55%] bg-olive/20" aria-hidden="true"></div>
      <div class="mt-3 h-px w-full bg-olive/15" aria-hidden="true"></div>

      <div class="flex flex-col gap-8 py-10 sm:flex-row sm:items-start sm:gap-[50px]">
        {items.map((item, i) => (
          <article
            class:list={[
              'relative mx-auto flex w-full max-w-md flex-col gap-5 max-[429px]:max-w-full sm:mx-0 sm:max-w-none sm:flex-1 sm:min-w-0',
              i > 0 && 'border-t border-olive/15 pt-8 sm:border-t-0 sm:pt-0',
            ]}
          >
            {i > 0 && (
              <span
                aria-hidden="true"
                class="pointer-events-none absolute top-0 bottom-0 hidden w-px bg-olive/15 sm:block sm:-left-[25px]"
              />
            )}
            <div class="flex w-full justify-center">
              <img
                src={item.icon}
                alt=""
                width="48"
                height="48"
                class="h-10 w-10 object-contain md:h-12 md:w-12"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="font-body text-center text-[18px] font-bold leading-snug text-olive">
              {item.title}
            </h3>
            <p class="font-body text-center text-base leading-relaxed text-olive/85">
              {item.description}
            </p>
          </article>
        ))}
      </div>

      {/* Interior completa → exterior corta */}
      <div class="mb-3 h-px w-full bg-olive/15" aria-hidden="true"></div>
      <div class="mx-auto h-px w-[55%] bg-olive/20" aria-hidden="true"></div>
    </div>
  )
}
