---
import Button from '../ui/Button.astro';
import Download from '@lucide/astro/icons/download';

interface Props {
  littleTitle: string;
  titleLines: string[];
  description: string;
  ctaPrimary: string;
  ctaSecondary: string;
  hrefPrimary: string;
  hrefSecondary?: string;
  backgroundImage: string;
  /** Bleed de respaldo / viñeta; debe armonizar con la foto (nunca el azul del home) */
  bleedColor?: string;
  height?: string;
}

const {
  littleTitle,
  titleLines = [],
  description,
  ctaPrimary,
  ctaSecondary,
  hrefPrimary,
  hrefSecondary,
  backgroundImage,
  bleedColor = '#120e0a',
  height = 'h-auto lg:h-[min(62svh,640px)] lg:min-h-[520px]',
} = Astro.props as Props;

const hasDossier = Boolean(hrefSecondary?.trim());
---

<section
  class={`typology-hero relative flex ${height} items-center overflow-hidden`}
  style={`--typology-bleed: ${bleedColor}`}
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <img
      src={backgroundImage}
      alt=""
      width="1480"
      height="640"
      class="absolute inset-0 h-full w-full scale-[1.02] object-cover object-[center_40%] opacity-55 md:opacity-100 md:object-center"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="typology-hero-edge typology-hero-edge-left"></div>
    <div class="typology-hero-edge typology-hero-edge-right"></div>
  </div>

  <div class="page-gutter relative z-10 w-full pt-36 pb-12 md:pt-34 md:pb-14 lg:pt-30 lg:pb-8">
    <div class="page-shell-nav">
      <div class="flex w-full max-w-xl flex-col items-start gap-5 md:max-w-2xl md:gap-6">
        {
          littleTitle && (
            <p class="font-slogan text-xl leading-none text-stone-light md:text-2xl lg:text-3xl">
              {littleTitle}
            </p>
          )
        }

        <h1 class="font-body text-[1.75rem] leading-[1.2] tracking-wide text-stone-light uppercase sm:text-[2rem] md:text-[2.5rem] md:leading-[1.2] lg:text-[50px] lg:leading-[1.2]">
          {
            titleLines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))
          }
        </h1>

        {
          description && (
            <p class="max-w-md font-body text-sm leading-relaxed text-stone-light/90 md:max-w-lg md:text-base">
              {description}
            </p>
          )
        }

        <div class="flex w-full flex-col gap-3 md:flex-row md:flex-wrap md:items-center md:gap-4">
          <Button href={hrefPrimary} variant="primary" size="lg" class="w-full md:w-auto">
            {ctaPrimary}
          </Button>
          <Button
            href={hasDossier ? hrefSecondary : undefined}
            target={hasDossier ? '_blank' : undefined}
            disabled={!hasDossier}
            variant="ghost"
            size="lg"
            class="w-full md:w-auto"
          >
            {ctaSecondary}
            <Download class="size-4 shrink-0" stroke-width={1.8} aria-hidden="true" />
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .typology-hero {
    background-color: var(--typology-bleed);
  }

  .typology-hero-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(4rem, 18vw, 14rem);
    pointer-events: none;
  }

  .typology-hero-edge-left {
    left: 0;
    width: clamp(12rem, 48vw, 36rem);
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--typology-bleed) 88%, transparent) 0%,
      color-mix(in srgb, var(--typology-bleed) 72%, transparent) 28%,
      color-mix(in srgb, var(--typology-bleed) 35%, transparent) 58%,
      transparent 100%
    );
  }

  .typology-hero-edge-right {
    right: 0;
    background: linear-gradient(
      to left,
      var(--typology-bleed) 0%,
      color-mix(in srgb, var(--typology-bleed) 55%, transparent) 45%,
      transparent 100%
    );
  }
</style>
