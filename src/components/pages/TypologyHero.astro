---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import Download from '@lucide/astro/icons/download';

interface Props {
  littleTitle: string;
  titleLines: string[];
  description: string;
  ctaPrimary: string;
  ctaSecondary: string;
  hrefPrimary: string;
  hrefSecondary?: string;
  backgroundImage: ImageMetadata;
  imageAlt?: string;
  bleedColor?: string;
  objectPosition?: string;
  height?: string;
}

const {
  littleTitle,
  titleLines = [],
  description,
  ctaPrimary,
  ctaSecondary,
  hrefPrimary,
  hrefSecondary,
  backgroundImage,
  imageAlt = '',
  bleedColor = '#120e0a',
  objectPosition = 'center 40%',
  height = 'h-auto lg:h-[min(62svh,640px)] lg:min-h-130',
} = Astro.props as Props;

const hasDossier = Boolean(hrefSecondary?.trim());
const resolvedAlt =
  imageAlt.trim() ||
  (titleLines.length > 0 ? titleLines.join(' ') : littleTitle) ||
  'Evento Nuar Events';
---

<section
  class={`typology-hero relative flex ${height} items-center overflow-hidden`}
  style={`--typology-bleed: ${bleedColor}`}
>
  <div class="pointer-events-none absolute inset-0">
    <Image
      src={backgroundImage}
      alt={resolvedAlt}
      widths={[720, 1080, 1440, 1920]}
      sizes="100vw"
      quality={88}
      format="webp"
      class="absolute inset-0 z-0 h-full w-full object-cover"
      style={`object-position: ${objectPosition}`}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div
      class="absolute inset-0 z-1"
      aria-hidden="true"
      style={`background: linear-gradient(to right, ${bleedColor}cc 0%, ${bleedColor}99 30%, ${bleedColor}59 55%, ${bleedColor}26 75%, transparent 100%)`}
    >
    </div>
  </div>

  <div class="page-gutter relative z-10 w-full pt-36 pb-12 md:pt-34 md:pb-14 lg:pt-30 lg:pb-8">
    <div class="page-shell-nav">
      <div class="flex w-full max-w-xl flex-col items-start gap-5 md:max-w-2xl md:gap-6">
        {
          littleTitle && (
            <p class="font-slogan text-xl leading-none text-stone-light md:text-2xl lg:text-3xl">
              {littleTitle}
            </p>
          )
        }

        <h1 class="font-body text-[1.75rem] leading-[1.2] tracking-wide text-stone-light uppercase sm:text-[2rem] md:text-[2.5rem] md:leading-[1.2] lg:text-[50px] lg:leading-[1.2]">
          {
            titleLines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))
          }
        </h1>

        {
          description && (
            <p class="max-w-md font-body text-sm leading-relaxed text-stone-light/90 md:max-w-lg md:text-base">
              {description}
            </p>
          )
        }

        <div class="flex w-full flex-col gap-3 md:flex-row md:flex-wrap md:items-center md:gap-4">
          <Button href={hrefPrimary} variant="primary" size="lg" class="w-full md:w-auto">
            {ctaPrimary}
          </Button>
          <Button
            href={hasDossier ? hrefSecondary : undefined}
            target={hasDossier ? '_blank' : undefined}
            disabled={!hasDossier}
            variant="ghost"
            size="lg"
            class="w-full md:w-auto"
          >
            {ctaSecondary}
            <Download class="size-4 shrink-0" stroke-width={1.8} aria-hidden="true" />
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .typology-hero {
    background-color: var(--typology-bleed);
  }
</style>
