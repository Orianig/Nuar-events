---
import Calendar from '@lucide/astro/icons/calendar';
import Users from '@lucide/astro/icons/users';
import MapPin from '@lucide/astro/icons/map-pin';
import Button from '../ui/Button.astro';
import type { MomentCardItem } from '../../types';

interface Props {
  kicker: string;
  title: string;
  ctaLabel?: string;
  hrefEvents?: string;
  items: MomentCardItem[];
}

const { kicker, title, ctaLabel, hrefEvents, items = [] } = Astro.props as Props;
---

{
  items.length > 0 && (
    <div>
      <p class="font-slogan text-xl leading-none text-olive md:text-2xl">{kicker}</p>
      <h2 class="mt-3 font-body text-[32px] font-normal leading-tight text-olive">{title}</h2>

      <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-5 sm:gap-x-5 sm:gap-y-6 lg:gap-5 xl:gap-6">
        {items.map((item) => {
          const href = item.href ?? hrefEvents;

          return (
            <a
              href={href}
              class="group/moment relative flex aspect-square w-full max-w-none flex-col overflow-hidden rounded-[14px] bg-white shadow-[0_1px_4px_rgb(91_88_53/8%)] no-underline outline-none transition-[box-shadow,transform] duration-200 max-[399px]:w-full min-[400px]:w-[calc((100%-1.25rem)/2)] hover:-translate-y-0.5 hover:shadow-[0_6px_18px_rgb(91_88_53/14%)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive lg:w-[calc((100%-3.75rem)/4)] lg:max-w-70"
            >
              <div class="min-h-0 flex-1 overflow-hidden bg-cream-light/60">
                {item.image ? (
                  <img
                    src={item.image}
                    alt=""
                    width="280"
                    height="280"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover/moment:scale-[1.04] motion-reduce:transition-none"
                    loading="lazy"
                    decoding="async"
                  />
                ) : null}
              </div>
              <div class="flex shrink-0 flex-col gap-1.5 px-3.5 py-3 text-olive">
                <div class="flex items-center gap-2">
                  <Calendar class="size-3.5 shrink-0" stroke-width={1.6} aria-hidden="true" />
                  <span class="font-body truncate text-sm leading-none">{item.event}</span>
                </div>
                <div class="flex items-center gap-2">
                  <Users class="size-3.5 shrink-0" stroke-width={1.6} aria-hidden="true" />
                  <span class="font-body truncate text-sm leading-none">{item.attendees}</span>
                </div>
                <div class="flex items-center gap-2">
                  <MapPin class="size-3.5 shrink-0" stroke-width={1.6} aria-hidden="true" />
                  <span class="font-body truncate text-sm leading-none">{item.location}</span>
                </div>
              </div>
            </a>
          );
        })}

        {ctaLabel && hrefEvents && (
          <div class="shrink-0">
            <Button
              href={hrefEvents}
              variant="text"
              size="md"
              class="!min-h-0 !px-0 !py-0 !text-olive whitespace-nowrap"
            >
              {ctaLabel}
            </Button>
          </div>
        )}
      </div>
    </div>
  )
}
