---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'text';
  size?: 'sm' | 'md' | 'lg';
  loading?: boolean;
  disabled?: boolean;
  href?: string;
  /** Si es string, fuerza descarga con ese nombre de archivo; si true, usa el nombre del recurso */
  download?: boolean | string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  loadingLabel?: string;
  preview?: 'active' | 'disabled' | 'loading';
}

const {
  variant = 'primary',
  size = 'md',
  loading = false,
  disabled = false,
  href,
  download,
  target,
  rel,
  type = 'button',
  class: className = '',
  loadingLabel = 'Cargando...',
  preview,
} = Astro.props;

const linkRel =
  rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined);

const isDisabled = disabled || preview === 'disabled';
const isLoading = loading || preview === 'loading';
const isActivePreview = preview === 'active';
const isInactive = isDisabled || isLoading;

const sizeClass = {
  sm: 'min-h-9 px-3.5 py-1.5',
  md: 'min-h-11 px-4 py-2',
  lg: 'min-h-14 px-5 py-3',
}[size];

const focusRing =
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive';

const baseClass = [
  'inline-flex items-center justify-center gap-2.5 rounded-[6px] border-solid border-[0.8px]',
  'font-body text-sm font-bold leading-none no-underline',
  variant === 'primary' ? '' : 'transition-colors',
  isLoading ? 'cursor-wait' : isDisabled ? 'cursor-not-allowed' : 'cursor-pointer',
  focusRing,
  sizeClass,
]
  .filter(Boolean)
  .join(' ');

const variantClass = (() => {
  if (variant === 'primary') {
    if (isDisabled) {
      return 'border-transparent bg-disabled text-text-disabled shadow-none';
    }
    if (isActivePreview) {
      return 'btn-primary-fill is-active-preview border-transparent text-stone-light';
    }
    if (isLoading) {
      return 'btn-primary-fill is-loading border-transparent text-stone-light';
    }
    return 'btn-primary-fill border-transparent text-stone-light';
  }

  if (variant === 'secondary') {
    if (isLoading) {
      return 'border-olive-light bg-btn-secondary text-olive-light';
    }
    if (isDisabled) {
      return 'border-text-disabled bg-transparent text-text-disabled';
    }
    if (isActivePreview) {
      return 'border-olive-light bg-stone-light text-olive-light';
    }
    return 'border-olive-light bg-btn-secondary text-olive-light hover:bg-cream-light/70 active:bg-stone-light';
  }

  if (variant === 'ghost') {
    if (isLoading) {
      return 'border-cream-light bg-transparent text-cream-light';
    }
    if (isDisabled) {
      return 'border-text-disabled bg-transparent text-text-disabled';
    }
    if (isActivePreview) {
      return 'border-cream-light bg-cream-light/25 text-cream-light';
    }
    return 'border-cream-light bg-transparent text-cream-light hover:bg-cream-light/20 active:bg-cream-light/30';
  }

  if (isDisabled) {
    return 'border-transparent bg-transparent text-text-disabled';
  }
  return 'group/btn border-transparent bg-transparent text-sand-dark hover:text-olive-dark';
})();

const Tag = href && !isInactive ? 'a' : 'button';
---

<Tag
  class:list={[baseClass, variantClass, className]}
  href={Tag === 'a' ? href : undefined}
  download={Tag === 'a' && download != null ? download : undefined}
  target={Tag === 'a' ? target : undefined}
  rel={Tag === 'a' ? linkRel : undefined}
  type={Tag === 'button' ? type : undefined}
  disabled={Tag === 'button' ? isInactive : undefined}
  aria-disabled={Tag === 'a' && isInactive ? 'true' : undefined}
  aria-busy={isLoading ? 'true' : undefined}
>
  {
    isLoading ? (
      <>
        <svg
          class="h-3.5 w-3.5 shrink-0 animate-spin motion-reduce:animate-none"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill="currentColor"
            d="M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.75 10h-2.1A6 6 0 1 1 12 6c1.48 0 2.82.54 3.87 1.43L13.5 10H20V3.5l-2.35 2.85Z"
          />
        </svg>
        <span>{loadingLabel}</span>
      </>
    ) : variant === 'text' ? (
      <>
        <span class="group-hover/btn:underline group-hover/btn:underline-offset-[0.2em]">{<slot />}</span>
        <span class="transition-transform group-hover/btn:translate-x-0.5 motion-reduce:transition-none" aria-hidden="true">
          →
        </span>
      </>
    ) : (
      <slot />
    )
  }
</Tag>
