---
interface Props {
  active?: boolean;
  disabled?: boolean;
  class?: string;
  preview?: 'active' | 'disabled';
  type?: 'button' | 'submit' | 'reset';
}

const {
  active = false,
  disabled = false,
  class: className = '',
  preview,
  type = 'button',
} = Astro.props;

const isActive = active || preview === 'active';
const isDisabled = disabled || preview === 'disabled';

const classes = [
  'inline-flex min-h-11 items-center justify-center rounded-[6px] border-[0.8px] px-4 py-2',
  'font-body text-sm font-bold leading-none transition-colors',
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive',
  isDisabled
    ? 'cursor-not-allowed border-text-disabled bg-disabled text-text-disabled'
    : isActive
      ? 'cursor-pointer border-transparent bg-sand-light text-olive-light'
      : 'cursor-pointer border-olive-light bg-stone-light/50 text-olive-light hover:bg-stone-light',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<button
  type={type}
  class={classes}
  aria-pressed={isActive ? 'true' : 'false'}
  disabled={isDisabled}
>
  <slot />
</button>
