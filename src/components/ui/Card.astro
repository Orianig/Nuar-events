---
import type { SocialNetwork } from './icons';
import Button from './Button.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  href?: string;
  ctaLabel?: string;
  image?: string;
  imageAlt?: string;
  network?: SocialNetwork;
  class?: string;
  preview?: 'hover';
  compact?: boolean;
}

const {
  title,
  subtitle,
  description,
  href,
  ctaLabel = 'Conócenos más',
  image,
  imageAlt = '',
  network = 'instagram',
  class: className = '',
  preview,
  compact = false,
} = Astro.props;

const isHoverPreview = preview === 'hover';

const cardClass = [
  'group/card relative flex w-full min-w-0 flex-col overflow-hidden rounded-xl border-[0.8px] border-olive-light bg-white',
  compact ? 'aspect-[280/340]' : 'aspect-[341/420]',
  'origin-center transition-[box-shadow,transform] duration-200',
  isHoverPreview ? 'scale-[1.02] shadow-btn' : 'shadow-none hover:scale-[1.02] hover:shadow-btn',
  'focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-olive',
  className,
]
  .filter(Boolean)
  .join(' ');

const bodyClass = [
  'relative flex min-h-0 flex-1 flex-col items-center text-center transition-colors duration-200',
  compact ? 'px-4 pb-3 pt-7' : 'px-5 pb-4 pt-9',
  isHoverPreview ? 'bg-stone-light/45' : 'bg-stone-light/25 group-hover/card:bg-stone-light/45',
].join(' ');
---

<article class={cardClass}>
  <div class="relative h-[42%] w-full shrink-0 overflow-hidden bg-white" data-card-media>
    {
      image ? (
        <img
          src={image}
          alt={imageAlt}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="h-full w-full bg-white" aria-hidden="true" />
      )
    }
  </div>

  <div class={bodyClass}>
    <span
      class:list={[
        'absolute left-1/2 top-0 flex -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-olive-dark text-stone-light',
        compact ? 'h-9 w-9' : 'h-11 w-11',
      ]}
      aria-hidden="true"
    >
      <SocialIcon
        network={network}
        class={compact ? 'h-5 w-5 text-stone-light' : 'h-7 w-7 text-stone-light'}
      />
    </span>

    <div class="flex w-full max-w-[301px] flex-col items-center">
      <h3
        class:list={[
          'font-body font-medium leading-snug text-olive',
          compact ? 'text-base' : 'text-lg',
        ]}
      >
        {title}
      </h3>

      {
        subtitle && (
          <p class="mt-1 font-body text-sm font-normal leading-snug text-olive-light line-clamp-1">
            {subtitle}
          </p>
        )
      }

      {
        description && (
          <p
            class:list={[
              'mt-2 font-body text-sm font-normal leading-snug text-olive',
              compact ? 'line-clamp-2' : '',
            ]}
          >
            {description}
          </p>
        )
      }
    </div>

    <div class:list={['mt-auto flex w-full justify-center', compact ? 'pt-3' : 'pt-6']}>
      <Button variant="text" size={compact ? 'sm' : 'md'} href={href}>
        {ctaLabel}
      </Button>
    </div>
  </div>
</article>
