---
import type { SocialNetwork } from './icons';
import Button from './Button.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  href?: string;
  ctaLabel?: string;
  image?: string;
  imageAlt?: string;
  network?: SocialNetwork;
  class?: string;
  preview?: 'hover';
}

const {
  title,
  subtitle,
  description,
  href,
  ctaLabel = 'Conócenos más',
  image,
  imageAlt = '',
  network = 'instagram',
  class: className = '',
  preview,
} = Astro.props;

const isHoverPreview = preview === 'hover';

const cardClass = [
  'group/card relative flex w-full min-w-0 flex-col overflow-hidden rounded-xl border-[0.8px] border-olive-light bg-white',
  'aspect-[341/420]',
  'transition-[box-shadow] duration-200',
  isHoverPreview ? 'shadow-btn' : 'shadow-none hover:shadow-btn',
  'focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-olive',
  className,
]
  .filter(Boolean)
  .join(' ');

const bodyClass = [
  'relative flex min-h-0 flex-1 flex-col items-center px-5 pb-4 pt-9 text-center',
  'transition-colors duration-200',
  isHoverPreview ? 'bg-stone-light/45' : 'bg-stone-light/25 group-hover/card:bg-stone-light/45',
].join(' ');
---

<article class={cardClass}>
  <div class="relative h-[42%] w-full shrink-0 overflow-hidden bg-white" data-card-media>
    {
      image ? (
        <img
          src={image}
          alt={imageAlt}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="h-full w-full bg-white" aria-hidden="true" />
      )
    }
  </div>

  <div class={bodyClass}>
    <span
      class="absolute left-1/2 top-0 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-olive-dark text-stone-light"
      aria-hidden="true"
    >
      <SocialIcon network={network} class="h-7 w-7 text-stone-light" />
    </span>

    <div class="flex w-full max-w-[301px] flex-col items-center">
      <h3 class="font-body text-lg font-medium leading-snug text-olive">{title}</h3>

      {
        subtitle && (
          <p class="mt-1 font-body text-sm font-normal leading-snug text-olive-light">{subtitle}</p>
        )
      }

      {
        description && (
          <p class="mt-3 font-body text-sm font-normal leading-snug text-olive">{description}</p>
        )
      }
    </div>

    <div class="mt-auto flex w-full justify-center pt-6">
      <Button variant="text" size="md" href={href}>
        {ctaLabel}
      </Button>
    </div>
  </div>
</article>
