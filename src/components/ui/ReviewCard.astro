---
import Star from '@lucide/astro/icons/star';

interface Props {
  quote: string;
  name: string;
  detail?: string;
  avatar?: string;
  avatarAlt?: string;
  /** 1–5; por defecto 5 (reseñas Google) */
  rating?: number;
  /** Carrusel home: alto fijo ~220px, texto truncado, comillas grandes */
  compact?: boolean;
  /** Hace la card clicable (abre popup desde el padre) */
  interactive?: boolean;
  class?: string;
}

const {
  quote,
  name,
  detail,
  avatar,
  avatarAlt = '',
  rating = 5,
  compact = false,
  interactive = false,
  class: className = '',
} = Astro.props;

const stars = Math.min(5, Math.max(0, Math.round(rating)));

const shellClass = [
  'flex w-full min-w-0 flex-col rounded-3xl border-[0.8px] border-olive-light bg-sand-light/10 text-left',
  compact ? 'h-55 overflow-hidden p-5 sm:h-59 md:p-6' : 'h-full p-8',
  interactive &&
    'origin-center cursor-pointer outline-none transition-[background-color,border-color,transform] duration-200 hover:scale-[1.015] hover:border-olive hover:bg-sand-light/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-olive',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{
  interactive ? (
    <button
      type="button"
      class={shellClass}
      data-review-trigger
      data-review-quote={quote}
      data-review-name={name}
      data-review-detail={detail || ''}
      data-review-avatar={avatar || ''}
      data-review-rating={String(stars)}
    >
      <div class="flex min-h-0 flex-1 flex-col">
        <div class:list={['flex min-h-0 gap-2', compact ? 'gap-2.5' : 'gap-3']}>
          <span
            class:list={[
              'shrink-0 font-body leading-none text-olive-light',
              compact ? 'text-6xl md:text-7xl' : 'text-4xl',
            ]}
            aria-hidden="true"
          >
            “
          </span>
          <p
            class:list={[
              'review-quote min-w-0 overflow-hidden font-body font-normal text-olive',
              compact
                ? 'review-quote--compact text-sm leading-[1.35] md:text-[15px]'
                : 'text-base leading-relaxed',
            ]}
          >
            {quote}
          </p>
        </div>

        <div
          class:list={['mt-auto flex items-center gap-1 pt-3', compact && 'pt-2.5']}
          aria-label={`${stars} de 5 estrellas`}
        >
          {Array.from({ length: 5 }).map((_, i) => (
            <Star
              class:list={['size-3.5 shrink-0', i < stars ? 'fill-olive text-olive' : 'fill-none text-sand']}
              stroke-width={1.6}
              aria-hidden="true"
            />
          ))}
        </div>

        <div class:list={['flex items-center gap-3', compact ? 'pt-3' : 'mt-6 pt-2']}>
          <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full bg-white">
            {avatar ? (
              <img
                src={avatar}
                alt=""
                class="h-full w-full object-cover"
                width="48"
                height="48"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="block h-full w-full bg-white" aria-hidden="true" />
            )}
          </div>
          <div class="min-w-0">
            <p class="font-body truncate text-sm font-medium leading-snug text-olive">{name}</p>
            {detail && (
              <p class="mt-0.5 font-body truncate text-sm font-normal leading-snug text-olive">{detail}</p>
            )}
          </div>
        </div>
      </div>
    </button>
  ) : (
    <figure class={shellClass}>
      <blockquote class:list={['flex min-h-0 flex-1 gap-2', compact ? 'gap-2.5' : 'gap-3']}>
        <span
          class:list={[
            'shrink-0 font-body leading-none text-olive-light',
            compact ? 'text-6xl md:text-7xl' : 'text-4xl',
          ]}
          aria-hidden="true"
        >
          “
        </span>
        <p
          class:list={[
            'review-quote min-w-0 overflow-hidden font-body font-normal text-olive',
            compact
              ? 'review-quote--compact text-sm leading-[1.35] md:text-[15px]'
              : 'text-base leading-relaxed',
          ]}
        >
          {quote}
        </p>
      </blockquote>

      <div
        class:list={['mt-4 flex items-center gap-1', compact && 'mt-2.5']}
        aria-label={`${stars} de 5 estrellas`}
      >
        {Array.from({ length: 5 }).map((_, i) => (
          <Star
            class:list={['size-3.5 shrink-0', i < stars ? 'fill-olive text-olive' : 'fill-none text-sand']}
            stroke-width={1.6}
            aria-hidden="true"
          />
        ))}
      </div>

      <figcaption class:list={['flex items-center gap-3', compact ? 'pt-3' : 'mt-6']}>
        <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full bg-white">
          {avatar ? (
            <img
              src={avatar}
              alt={avatarAlt || name}
              class="h-full w-full object-cover"
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="block h-full w-full bg-white" aria-hidden="true" />
          )}
        </div>
        <div class="min-w-0">
          <p class="font-body truncate text-sm font-medium leading-snug text-olive">{name}</p>
          {detail && (
            <p class="mt-0.5 font-body truncate text-sm font-normal leading-snug text-olive">{detail}</p>
          )}
        </div>
      </figcaption>
    </figure>
  )
}

<style>
  /* Tope duro de altura = N líneas exactas: evita ver el inicio de la siguiente */
  .review-quote--compact {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    max-height: calc(1.35em * 3);
  }

  @media (min-width: 640px) {
    .review-quote--compact {
      -webkit-line-clamp: 4;
      line-clamp: 4;
      max-height: calc(1.35em * 4);
    }
  }
</style>
