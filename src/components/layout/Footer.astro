---
import type { FooterProps } from '../../types';
import IconButton from '../ui/IconButton.astro';

const {
  brandName = 'NUAR',
  sloganLine1 = 'Creando momentos, porque al',
  sloganLine2 = 'final, la vida se mide en ellos',
  followUs = 'SÍGUENOS',
  privacy = 'Política de privacidad',
  currentLang = 'es',
  base = '',
} = Astro.props as FooterProps;

const b = base.endsWith('/') ? base.slice(0, -1) : base;
const hrefPrivacy =
  currentLang === 'en'
    ? b
      ? `${b}/en/politica-de-privacidad`
      : '/en/politica-de-privacidad'
    : b
      ? `${b}/politica-de-privacidad`
      : '/politica-de-privacidad';

const socialLinks = [
  {
    network: 'instagram' as const,
    href: 'https://www.instagram.com/nuarevents/',
    label: 'Instagram de Nuar Events',
  },
  {
    network: 'tiktok' as const,
    href: 'https://www.tiktok.com/@nuareventss',
    label: 'TikTok de Nuar Events',
  },
  {
    network: 'linkedin' as const,
    href: 'https://www.linkedin.com/company/nuar-events/posts/?feedView=all',
    label: 'LinkedIn de Nuar Events',
  },
];
---

<footer class="bg-ink-dark text-sand">
  <div class="page-gutter">
    <div class="page-shell-nav py-12 md:py-14">
    <div class="flex flex-col items-center gap-12 md:flex-row md:items-center md:justify-between">
      <div class="flex max-w-sm flex-col items-start text-left">
        <img
          src="/Logo-5.png"
          alt={brandName}
          width="160"
          height="48"
          class="h-10 w-auto object-contain md:h-12"
          loading="lazy"
          decoding="async"
        />
        <p class="mt-4 font-body text-sm leading-relaxed text-sand/90 md:text-base">
          {sloganLine1}
          <br />
          {sloganLine2}
        </p>
      </div>

      <div class="flex flex-col items-center gap-4 text-center">
        <p class="font-body text-xs font-medium uppercase tracking-[0.18em] text-sand/80">
          {followUs}
        </p>

        <div class="flex items-center gap-3" aria-label="Redes sociales Nuar Events">
          {
            socialLinks.map((item) => (
              <IconButton network={item.network} href={item.href} label={item.label} social />
            ))
          }
        </div>

        <a
          href={hrefPrivacy}
          class="font-body text-sm text-sand/80 underline-offset-2 transition-opacity hover:text-sand hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sand"
        >
          {privacy}
        </a>
      </div>
    </div>
    </div>
  </div>
</footer>
