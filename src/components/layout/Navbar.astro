---
import type { NavbarProps } from '../../types';
import LangSwitcher from './LangSwitcher.astro';
import { getTranslations } from '../../i18n';
import { EVENT_TYPE_SLUGS, eventTypeHref, allEventsHref } from '../../lib/eventTypes';

const {
  brandName,
  home,
  projects,
  aboutNuar,
  upcomingEvents,
  contact,
  menuToggle,
  eventTypes,
  currentLang = 'es',
  currentPath = '/',
  base = '',
} = Astro.props as NavbarProps;

const t = getTranslations(currentLang);
const b = base.endsWith('/') ? base.slice(0, -1) : base;
const isSpanish = currentLang === 'es';
const hrefHome = isSpanish ? (b ? `${b}/` : '/') : (b ? `${b}/en/` : '/en/');
const hrefAboutNuar = isSpanish
  ? b
    ? `${b}/about-nuar`
    : '/about-nuar'
  : b
    ? `${b}/en/about-nuar`
    : '/en/about-nuar';
const hrefContact = isSpanish ? (b ? `${b}/contact` : '/contact') : (b ? `${b}/en/contact` : '/en/contact');
const hrefAllEvents = allEventsHref(currentLang, base);

const labelBySlug = {
  corporativos: t.nav.eventTypes.corporate,
  bodas: t.nav.eventTypes.weddings,
  cumpleanos: t.nav.eventTypes.birthdays,
  graduaciones: t.nav.eventTypes.graduations,
  otros: t.nav.eventTypes.others,
} as const;

const resolvedEventTypes =
  eventTypes ??
  EVENT_TYPE_SLUGS.map((slug) => ({
    label: labelBySlug[slug],
    href: eventTypeHref(slug, currentLang, base),
  }));

const ourEventsLinks = [
  ...resolvedEventTypes,
  { label: t.nav.eventTypes.all, href: hrefAllEvents },
];

function normalizePath(path: string): string {
  if (!path) return '/';
  const p = path.split('#')[0].split('?')[0];
  if (p.length > 1 && p.endsWith('/')) return p.slice(0, -1);
  return p || '/';
}

const current = normalizePath(currentPath);
const homePath = normalizePath(hrefHome);
const aboutNuarPath = normalizePath(hrefAboutNuar);
const contactPath = normalizePath(hrefContact);
const eventosRoot = normalizePath(hrefAllEvents);
const historiasRoot = isSpanish
  ? normalizePath(b ? `${b}/historias` : '/historias')
  : normalizePath(b ? `${b}/en/historias` : '/en/historias');

const isHomeActive = current === homePath;
const isEventsActive =
  current === aboutNuarPath ||
  current.startsWith(`${aboutNuarPath}/`) ||
  current === eventosRoot ||
  current.startsWith(`${eventosRoot}/`) ||
  current === historiasRoot ||
  current.startsWith(`${historiasRoot}/`);
const isContactActive = current === contactPath || current.startsWith(`${contactPath}/`);

const disabledNavClass =
  'block cursor-not-allowed select-none rounded-xl px-3 py-2.5 text-sm text-bark/40';
const disabledNavClassMobile = 'cursor-not-allowed select-none text-sm text-bark/40';
---

<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-40 hidden bg-bark/55 md:hidden"
  aria-hidden="true"
></div>
<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-45 min-h-[65px] border-b-[0.5px] border-stone bg-stone-light/58 transition-[box-shadow,background-color] duration-300"
>
  <div class="page-gutter">
    <div class="page-shell-nav py-2.5">
      <div class="flex min-h-[65px] w-full items-center justify-between gap-2.5">
        <a href={hrefHome} class="inline-flex items-center transition-opacity hover:opacity-80">
          <img
            src="/NUAR-navbar.svg"
            alt={brandName}
            width="126"
            height="38"
            class="h-[38px] w-auto object-contain"
            loading="eager"
            decoding="async"
          />
          <span class="sr-only">{brandName}</span>
        </a>

        <div class="hidden items-center gap-8 md:flex">
          <a
            href={hrefHome}
            class:list={[
              'inline-flex items-center border-b-2 py-2 font-medium text-bark transition-opacity hover:opacity-80',
              isHomeActive ? 'border-bark' : 'border-transparent',
            ]}
          >
            {home}
          </a>

          <div class="events-dropdown relative">
            <button
              type="button"
              class:list={[
                'events-trigger inline-flex cursor-pointer items-center gap-1 border-b-2 py-2 font-medium text-bark transition-opacity hover:opacity-80',
                isEventsActive ? 'border-bark' : 'border-transparent',
              ]}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {projects}
              <svg
                class="events-chevron h-4 w-4 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div class="events-menu absolute left-1/2 top-full z-20 hidden w-56 -translate-x-1/2 pt-2">
              <div class="rounded-2xl border border-bark/20 bg-stone/95 p-2 shadow-lg backdrop-blur">
                <a
                  href={hrefAboutNuar}
                  class="block rounded-xl px-3 py-2.5 text-sm text-bark transition-colors hover:bg-bark/10"
                >
                  {aboutNuar ?? t.nav.aboutNuar}
                </a>

                <div class="group/types relative">
                  <button
                    type="button"
                    class="flex w-full cursor-pointer items-center justify-between rounded-xl px-3 py-2.5 text-left text-sm text-bark transition-colors hover:bg-bark/10"
                    aria-haspopup="true"
                  >
                    <span>{t.nav.ourEvents}</span>
                    <svg
                      class="h-3.5 w-3.5 transition-transform group-hover/types:translate-x-0.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>

                  <div
                    class="invisible absolute top-0 left-full z-30 w-56 pl-2 opacity-0 transition-[opacity,visibility] duration-150 group-hover/types:visible group-hover/types:opacity-100 group-focus-within/types:visible group-focus-within/types:opacity-100"
                  >
                    <div class="rounded-2xl border border-bark/20 bg-stone/95 p-2 shadow-lg backdrop-blur">
                      {
                        ourEventsLinks.map((item) => (
                          <a
                            href={item.href}
                            class="block rounded-xl px-3 py-2.5 text-sm text-bark transition-colors hover:bg-bark/10"
                          >
                            {item.label}
                          </a>
                        ))
                      }
                    </div>
                  </div>
                </div>

                <span class={disabledNavClass} aria-disabled="true">
                  {upcomingEvents ?? t.nav.upcomingEvents}
                </span>
              </div>
            </div>
          </div>

          <a
            href={hrefContact}
            class:list={[
              'inline-flex items-center border-b-2 py-2 font-medium text-bark transition-opacity hover:opacity-80',
              isContactActive ? 'border-bark' : 'border-transparent',
            ]}
          >
            {contact}
          </a>
          <LangSwitcher currentLang={currentLang} currentPath={currentPath} />
        </div>

        <button
          id="mobile-menu-button"
          class="text-bark transition-opacity hover:opacity-80 md:hidden"
          aria-label={menuToggle}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <div id="mobile-menu" class="hidden pb-2 pt-4 md:hidden">
        <div class="flex flex-col items-center gap-4">
          <a
            href={hrefHome}
            class:list={[
              'border-b-2 pb-1 font-medium text-bark transition-opacity hover:opacity-80',
              isHomeActive ? 'border-bark' : 'border-transparent',
            ]}
          >
            {home}
          </a>

          <div class="w-full max-w-[260px]">
            <button
              id="mobile-events-button"
              type="button"
              class:list={[
                'inline-flex w-full cursor-pointer items-center justify-center gap-1 border-b-2 pb-1 font-medium text-bark transition-opacity hover:opacity-80',
                isEventsActive ? 'border-bark' : 'border-transparent',
              ]}
              aria-expanded="false"
            >
              {projects}
              <svg id="mobile-events-chevron" class="h-4 w-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div id="mobile-events-menu" class="mt-3 hidden flex-col items-center gap-3 text-center">
              <a href={hrefAboutNuar} class="text-sm text-bark/85 transition-opacity hover:opacity-80">
                {aboutNuar ?? t.nav.aboutNuar}
              </a>

              <button
                id="mobile-event-types-button"
                type="button"
                class="inline-flex cursor-pointer items-center justify-center gap-1 text-sm text-bark/85 transition-opacity hover:opacity-80"
                aria-expanded="false"
              >
                {t.nav.ourEvents}
                <svg id="mobile-event-types-chevron" class="h-3.5 w-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="mobile-event-types-menu" class="hidden w-full flex-col items-center gap-2.5">
                {
                  ourEventsLinks.map((item) => (
                    <a href={item.href} class="text-sm text-bark/75 transition-opacity hover:opacity-80">
                      {item.label}
                    </a>
                  ))
                }
              </div>

              <span class={disabledNavClassMobile} aria-disabled="true">
                {upcomingEvents ?? t.nav.upcomingEvents}
              </span>
            </div>
          </div>

          <a
            href={hrefContact}
            class:list={[
              'border-b-2 pb-1 font-medium text-bark transition-opacity hover:opacity-80',
              isContactActive ? 'border-bark' : 'border-transparent',
            ]}
          >
            {contact}
          </a>
          <LangSwitcher currentLang={currentLang} currentPath={currentPath} />
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileBackdrop = document.getElementById('mobile-menu-backdrop');
  const eventsTrigger = document.querySelector('.events-trigger') as HTMLButtonElement | null;
  const eventsMenu = document.querySelector('.events-menu') as HTMLElement | null;
  const eventsChevron = document.querySelector('.events-chevron') as SVGElement | null;
  const mobileEventsButton = document.getElementById('mobile-events-button') as HTMLButtonElement | null;
  const mobileEventsMenu = document.getElementById('mobile-events-menu');
  const mobileEventsChevron = document.getElementById('mobile-events-chevron');
  const mobileEventTypesButton = document.getElementById('mobile-event-types-button') as HTMLButtonElement | null;
  const mobileEventTypesMenu = document.getElementById('mobile-event-types-menu');
  const mobileEventTypesChevron = document.getElementById('mobile-event-types-chevron');

  function closeDesktopEventsMenu() {
    eventsMenu?.classList.add('hidden');
    eventsTrigger?.setAttribute('aria-expanded', 'false');
    eventsChevron?.classList.remove('rotate-180');
  }

  let ignoreOutsideClick = false;

  function setMobileMenuOpen(open: boolean) {
    mobileMenu?.classList.toggle('hidden', !open);
    mobileBackdrop?.classList.toggle('hidden', !open);
    mobileBackdrop?.setAttribute('aria-hidden', open ? 'false' : 'true');
    nav?.classList.toggle('nav-menu-open', open);
    menuButton?.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.style.overflow = open ? 'hidden' : '';
  }

  function closeMobileMenus() {
    setMobileMenuOpen(false);
    mobileEventsMenu?.classList.add('hidden');
    mobileEventsMenu?.classList.remove('flex');
    mobileEventsButton?.setAttribute('aria-expanded', 'false');
    mobileEventsChevron?.classList.remove('rotate-180');
    mobileEventTypesMenu?.classList.add('hidden');
    mobileEventTypesMenu?.classList.remove('flex');
    mobileEventTypesButton?.setAttribute('aria-expanded', 'false');
    mobileEventTypesChevron?.classList.remove('rotate-180');
  }

  function updateNavOnScroll() {
    if (nav?.classList.contains('nav-menu-open')) return;
    if (window.scrollY > 20) {
      nav?.classList.add('nav-scrolled');
    } else {
      nav?.classList.remove('nav-scrolled');
    }
  }

  window.addEventListener('scroll', updateNavOnScroll, { passive: true });
  updateNavOnScroll();

  menuButton?.addEventListener('click', (e) => {
    e.stopPropagation();
    const willOpen = mobileMenu?.classList.contains('hidden');
    if (willOpen) {
      ignoreOutsideClick = true;
      setMobileMenuOpen(true);
      queueMicrotask(() => {
        ignoreOutsideClick = false;
      });
    } else {
      closeMobileMenus();
    }
  });

  mobileBackdrop?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeMobileMenus();
  });

  eventsTrigger?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    const willOpen = eventsMenu?.classList.contains('hidden');
    if (willOpen) {
      eventsMenu?.classList.remove('hidden');
      eventsTrigger.setAttribute('aria-expanded', 'true');
      eventsChevron?.classList.add('rotate-180');
    } else {
      closeDesktopEventsMenu();
    }
  });

  document.addEventListener('click', (e) => {
    const inside = (e.target as HTMLElement | null)?.closest?.('.events-dropdown');
    if (!inside) closeDesktopEventsMenu();
  });

  mobileEventsButton?.addEventListener('click', () => {
    const isHidden = mobileEventsMenu?.classList.toggle('hidden');
    mobileEventsMenu?.classList.toggle('flex', !isHidden);
    mobileEventsButton.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
    mobileEventsChevron?.classList.toggle('rotate-180', !isHidden);
    if (isHidden) {
      mobileEventTypesMenu?.classList.add('hidden');
      mobileEventTypesMenu?.classList.remove('flex');
      mobileEventTypesButton?.setAttribute('aria-expanded', 'false');
      mobileEventTypesChevron?.classList.remove('rotate-180');
    }
  });

  mobileEventTypesButton?.addEventListener('click', () => {
    const isHidden = mobileEventTypesMenu?.classList.toggle('hidden');
    mobileEventTypesMenu?.classList.toggle('flex', !isHidden);
    mobileEventTypesButton.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
    mobileEventTypesChevron?.classList.toggle('rotate-180', !isHidden);
  });

  document.addEventListener('click', (e) => {
    if (!mobileMenu || !menuButton || ignoreOutsideClick) return;
    const target = e.target as Node;
    if (
      window.innerWidth < 768 &&
      !mobileMenu.contains(target) &&
      !menuButton.contains(target) &&
      !mobileBackdrop?.contains(target)
    ) {
      closeMobileMenus();
    }
  });
</script>
